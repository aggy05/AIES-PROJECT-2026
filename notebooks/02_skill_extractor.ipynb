   "source": [
    "def extract_skills(text, skills_db):\n",
    "    text_lower = text.lower()\n",
    "    found = []\n",
    "\n",
    "    for skill, synonyms in skills_db.items():\n",
    "        for synonym in synonyms:\n",
    "            if synonym in text_lower:\n",
    "                found.append(skill)\n",
    "                break\n",
    "\n",
    "    return found\n",
    "\n",
    "resume_skills = extract_skills(full_text, skills_database)\n",
    "\n",
    "print(\"Skills found in resume:\")\n",
    "for skill in resume_skills:\n",
    "    print(\" -\", skill)\n",
    "print(f\"\\nTotal: {len(resume_skills)} skills found\")"
   ]
  }
