    "import pdfplumber\n",
    "\n",
    "with pdfplumber.open(\"../resumes/sample_resume.pdf\") as pdf:\n",
    "    full_text = \"\"\n",
    "    for page in pdf.pages:\n",
    "        text = page.extract_text()\n",
    "        full_text += text if text else \"\""
   ]
